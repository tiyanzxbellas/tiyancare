# Base URL untuk Scraper API
VITE_API_BASE_URL=https://name-neko-api.vercel.app

# DoujinDesu API lewat proxy same-origin. Ini mencegah request browser gagal karena CORS.
# Untuk deployment selain Vercel, sediakan reverse proxy /doujin-api -> https://doujin.desu.xxx/api.
VITE_DOUJINDESU_API_BASE_URL=/doujin-api
