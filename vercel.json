{
  "version": 2,
  "rewrites": [
    {
      "source": "/api-proxy/(.*)",
      "destination": "https://name-neko-api.vercel.app/$1"
    },
    {
      "source": "/doujin-api/(.*)",
      "destination": "https://doujin.desu.xxx/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
